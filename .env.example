# ==============================================================================
# CBH Fasteners - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' and customize values for your environment.
# Note: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="CBH Fasteners"
NEXT_PUBLIC_CONTACT_PHONE="+91 98880 21000"
NEXT_PUBLIC_CONTACT_EMAIL="sales@cbh.store"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MYSQL)
# ------------------------------------------------------------------------------
# MySQL Connection URL format:
# mysql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL="mysql://root:password@localhost:3306/cbh_fasteners"

# Discrete MySQL connection parameters (alternative):
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="password"
DB_NAME="cbh_fasteners"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# Secret keys for signing JWTs, session cookies, and NextAuth
JWT_SECRET="cbh_jwt_secret_development_key_change_in_production_2025"
NEXTAUTH_SECRET="cbh_nextauth_secret_development_key_change_in_production_2025"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. BUSINESS & COMMUNICATION CHANNELS (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
# Official WhatsApp Desk for Instant RFQs & PDF Dispatches (+91 98880 21000)
NEXT_PUBLIC_WHATSAPP_NUMBER="919888021000"

# Transactional Email (Resend / SendGrid / SMTP)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="CBH Fasteners <orders@cbh.store>"

# Indian GST Portal Verification API (Optional)
# GST_PORTAL_API_KEY=""
